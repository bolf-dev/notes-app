# Copy to .env and fill in your values: cp .env.example .env

APP_PORT=8080
FRONTEND_PORT=5173

DB_PORT=3306
DB_NAME=notes_app
DB_USER=notes_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Host "db" = name of the database service in docker-compose.yml
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@db:3306/${DB_NAME}?serverVersion=12.3.2-MariaDB&charset=utf8mb4"
